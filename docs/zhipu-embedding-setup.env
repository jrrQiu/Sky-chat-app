# ============================================================================
#  Embedding 配置参考（硅基流动 / BAAI-bge-m3）
# ============================================================================
#
#  注意：这个文件的前身是智谱（BigModel）的配置模板。改用硅基流动后，原内容
#  已作废；沙箱不允许删除文件，因此改为直接覆写为当前有效的配置。
#
#  实际生效的配置在 agent-service/.env，本文件只是参考副本。
#
# ---------------------------------------------------------------------------
#  为什么必须写到 agent-service/.env
# ---------------------------------------------------------------------------
#  app/config.py 里 env_file=".env" 是**相对路径**，服务从 agent-service/ 启动
#  （README 的运行方式 `python -m app`），所以它只读 agent-service/.env，
#  永远不读仓库根 .env。
#
# ---------------------------------------------------------------------------
#  为什么不能用 DeepSeek 的 key
# ---------------------------------------------------------------------------
#  DeepSeek 不提供 /embeddings 端点。填进去只会让每个请求 404 →
#  embed_batch 返回 [None, ...] → 稠密通道**静默降级**为 lexical_only，
#  日志里只有一条 warning。必须用一个真实的 embedding 服务。
#
# ---------------------------------------------------------------------------
#  当前有效配置（与 agent-service/.env 一致）
# ---------------------------------------------------------------------------
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY="<你的硅基流动密钥，形如 sk-...>"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIMENSION="1024"
EMBEDDING_BATCH_SIZE="64"
# 必须为 true：graph 节点只在 RETRIEVAL_USE_LLM 或 RETRIEVAL_USE_POSTGRES
# 为真时才去解析 provider。只配 key 不加这行，/ready 会如实报
# provider: null / mode: lexical_only。
RETRIEVAL_USE_LLM="true"

# ============================================================================
#  维度为什么必须是 1024
# ============================================================================
#  schema.sql 里 knowledge_chunk.embedding 与 knowledge_document.embedding
#  都是 vector(1024)，且数据库已按此迁移过。
#
#  BAAI/bge-m3 固定输出 1024 维，所以两边天然一致，**不需要**像 embedding-3
#  那样在请求里传 dimensions 字段——本项目当前也不会发送该字段。
#
#  换模型时必须同时改 EMBEDDING_DIMENSION、schema.sql 的 vector(N)，并对已有
#  库执行 ALTER + 重建 HNSW 索引（索引与列维度绑定）。不同模型的向量不可混用：
#  混着算余弦相似度不会报错，只会让排序失去意义。
#
#  pgvector 的 HNSW 索引上限是 2000 维（实测 vector(2001) 直接报
#  "cannot have more than 2000 dimensions for hnsw index"），所以不要选 2048 维
#  及以上的模型，除非改用 halfvec。
#
# ============================================================================
#  验证顺序（顺序错了会白跑）
# ============================================================================
#
#  1) 确认 API 连通且返回 1024 维：
#       cd agent-service
#       .\.venv\Scripts\python.exe -c "from app.retrieval.embedding import default_embedding_provider as p; v=p().embed('测试'); print('dim =', len(v) if v else None)"
#     期望 dim = 1024。若为 None，说明密钥/网络/额度有问题。
#
#  2) 灌向量 + 建索引（embedded 必须 > 0，ann 必须是 True）：
#       .\.venv\Scripts\python.exe -c "from app.persistence.knowledge_repository import PostgresKnowledgeRepository as R; from app.knowledge.ingest import build_seed_index; r=R(); r.ensure_schema(); r.seed(build_seed_index()); print('embedded =', r.count_chunk_embeddings(), '| ann =', r.has_ann_index())"
#
#  3) 端到端（mode 必须是 hybrid，且证据里出现 vector）：
#       .\.venv\Scripts\python.exe ..\.buildcheck\rag_siliconflow_verify.py
#
#  4) 重启服务后看 /ready：retrieval_mode 应为 hybrid，
#     dense_embeddings.provider 应为 http。
#
#  备注：重启服务无法由自动化完成——8000 端口由一个进程管理器持有的旧实例占用，
#  需要在你自己的终端里停掉后再 `python -m app`。
#
# ============================================================================
#  当前状态（2026-10 实测）
# ============================================================================
#  chunks = 26，chunks with embedding = 26，ANN index = True
#  retrieval_mode = hybrid，dense_backend = pgvector
#
#  语义检索有效性抽查（这些查询字面上与目标文档无关键词重合，纯词法检索命中不了）：
#    「在家办公怎么连公司内网」 -> VPN 外网访问制度
#    「出差花的钱怎么报销」     -> 差旅报销规范
#    「忘了登录密码怎么办」     -> 密码重置流程
