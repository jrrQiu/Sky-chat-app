# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/front-service/node_modules
/.m2/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build
/dist
/front-service/dist
/.vite
/front-service/.vite
/.next/

# Codex runtime logs
/.codex-runtime-logs/

# Java
/java-service/.m2
/java-service/target

# Python
/agent-service/.venv
/agent-service/**/__pycache__

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
/app/generated/prisma

# local toolchains
/.tools/
